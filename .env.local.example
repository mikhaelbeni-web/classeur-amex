# --- Firebase (Auth + Firestore) ---
# Depuis Firebase Console > Paramètres du projet > Général > "Vos
# applications" > Config SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Supabase (Storage uniquement, pour les fichiers de justificatifs) ---
# Depuis Supabase > ton projet > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ces valeurs sont publiques par nature (elles partent dans le bundle JS du
# navigateur) : la sécurité réelle vient des règles Firestore
# (firestore.rules) et des policies Supabase Storage, pas du secret de ces
# clés.
