rules_version = '2';

// Accès restreint aux deux personnes qui utilisent l'outil.
function isAllowed() {
  return request.auth != null &&
    request.auth.token.email in [
      'gestion@beylev.com',
      'compta@beylev.com'
    ];
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /statements/{statementId} {
      allow read, write: if isAllowed();

      match /lines/{lineId} {
        allow read, write: if isAllowed();
      }
    }

    // Nécessaire en plus de la règle ci-dessus : une requête collectionGroup
    // (utilisée pour écouter TOUTES les lignes de TOUS les relevés à la fois)
    // n'est couverte que par une règle avec le wildcard récursif {path=**}.
    // Sans elle, Firestore refuse la requête même si les documents sont
    // par ailleurs lisibles un par un.
    match /{path=**}/lines/{lineId} {
      allow read, write: if isAllowed();
    }
  }
}